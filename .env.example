# Local demonstration only. No real credentials.
FRONTEND_PORT=3000
MYSQL_DATABASE=material_app
MYSQL_USER=material_app
MYSQL_PASSWORD=local_demo_password
MYSQL_ROOT_PASSWORD=local_demo_root_password
# Internal Docker network; do not expose this as NEXT_PUBLIC_*.
JAVA_API_BASE_URL=http://backend:8080
DEMO_MODE=true
SESSION_TTL_DAYS=7
COOKIE_SECURE=false
SIMULATION_ENABLED=true
SIM_CHECK_MS=1500
SIM_GEN_MS=6000
SIM_FINALIZE_MS=1500
QUEUE_POLL_MS=500
